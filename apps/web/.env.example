# Frontend environment — copy to .env.local for local development.
#
#   cp .env.example .env.local

# Where the browser sends API calls.
#
# Point it straight at the backend in local development. Leave it as the
# relative /api/v1 in a deployment, where the browser then talks to this app's
# own proxy route (src/app/api/v1/[...path]/route.ts) and the backend is never
# exposed to the browser directly.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Where that proxy route forwards to, server-side. Required whenever
# NEXT_PUBLIC_API_URL is relative — without it the proxy has no upstream and
# answers 503. Leave it commented out in local development, where the proxy
# falls back to http://localhost:8000/api/v1.
#
# Commented rather than left empty: `API_URL=` sets it to an empty string, which
# is not the same as unset. That empty value used to defeat the fallback below
# and made every /api/v1/* call answer 503 for anyone who copied this file.
# API_URL=https://your-api-host/api/v1

# Build a self-contained server bundle (.next/standalone). The Dockerfile needs
# it; `npm run dev` and `npm start` do not.
NEXT_OUTPUT_STANDALONE=false
